# =============================================================================
#  poly_bot 环境配置
#  Environment Configuration
#
#  复制为 .env 后填写必填项:
#  Copy to .env and fill required fields:
#    cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# [1] 账户认证
#     Account & Authentication  REQUIRED
# -----------------------------------------------------------------------------

# Polymarket 私钥（64 位 hex，可带或不带 0x 前缀）
# Private key (64-char hex, with or without 0x prefix)
# 邮箱/Magic 账号: https://reveal.magic.link/polymarket
# Email/Magic: https://reveal.magic.link/polymarket
# 浏览器钱包: 导出对应 EOA 私钥
# Browser wallet: export your EOA private key

POLYMARKET_PRIVATE_KEY=

# 资金托管地址（Settings 里显示的 Address，非 EOA 签名地址）
# Funder address from Polymarket Settings (NOT your EOA signer address)
# https://polymarket.com/settings?tab=builder → Address
# 邮箱与浏览器钱包在 V2 下通常均为 deposit wallet，填 Settings 地址即可
# For V2, both email and browser accounts usually use the deposit wallet from Settings

POLYMARKET_PROXY_ADDRESS=


# -----------------------------------------------------------------------------
# [2] Builder API  REQUIRED for Merge
#     Merge / Redeem 前必须填写
# -----------------------------------------------------------------------------

# 在 Polymarket → Settings → Builders → Create New 获取
# Get from Polymarket → Settings → Builders → Create New
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=


# -----------------------------------------------------------------------------
# [3] CLOB 接口
#     CLOB API  optional
# -----------------------------------------------------------------------------

# API 地址 — 使用 https://clob.polymarket.com（不要用 clob-v2.polymarket.com）
# API endpoint — use https://clob.polymarket.com (NOT clob-v2.polymarket.com)
CLOB_API_URL=https://clob.polymarket.com

# 签名类型 — 按「资金托管钱包类型」选择，与登录方式（邮箱/钱包）无必然对应
# Signature type — based on funder wallet type, NOT login method (email vs browser)
#
#   Poly1271 | deposit | 3  — V2 deposit wallet（默认；邮箱/Magic 与浏览器钱包均适用）
#   Poly1271 | deposit | 3  — V2 deposit wallet (default; email/Magic and browser wallet)
#
#   Proxy | magic | email    — 仅 V1 旧 Magic 代理（Settings 地址 = ProxyFactory 推导地址）
#   Proxy | magic | email    — legacy Magic proxy only (Settings addr = ProxyFactory derive)
#
#   GnosisSafe | safe         — Gnosis Safe
#   Eoa | 0                   — 纯 EOA 直连（无需 POLYMARKET_PROXY_ADDRESS）
#   Eoa | 0                   — direct EOA (no POLYMARKET_PROXY_ADDRESS)
#
# 若 Proxy 下单报 "please use the deposit wallet flow" → 改用 Poly1271
# If Proxy orders fail with "please use the deposit wallet flow" → use Poly1271
SIGNATURE_TYPE=Poly1271

# -----------------------------------------------------------------------------
# [4] 链上 & Relayer
#     On-chain & Relayer  optional
# -----------------------------------------------------------------------------

RELAYER_URL=https://relayer-v2.polymarket.com

# Merge / Redeem 输出代币（默认 pUSD）
# Output token after Merge or Redeem (default: pUSD)
MERGE_OUTPUT_TOKEN=pUSD

# Merge 后自动 wrap 为 pUSD
# Auto-wrap merge proceeds to pUSD via Collateral Onramp
MERGE_WRAP_TO_PUSD=true
REDEEM_OUTPUT_TOKEN=pUSD

# Polygon RPC（不填则使用内置公共节点）
# Polygon RPC (uses built-in public node if unset)
# RPC_URL=https://polygon-bor-rpc.publicnode.com


# -----------------------------------------------------------------------------
# [5] 市场发现
#     Market Discovery  optional
# -----------------------------------------------------------------------------

# 监控的加密货币符号，逗号分隔
# Comma-separated crypto symbols to monitor
CRYPTO_SYMBOLS=btc,eth

# 距下一窗口开始前多少秒预先查询市场
# Seconds before the next window starts to query markets
MARKET_REFRESH_ADVANCE_SECS=5

# 市场窗口周期（分钟）：5 或 15（Polymarket crypto up/down 仅存在这两种周期）
# Market window period in minutes; Polymarket crypto up/down only exists as 5m/15m
MARKET_PERIOD_MINUTES=5


# -----------------------------------------------------------------------------
# [6] 套利 & 下单
#     Arbitrage & Orders  optional
# -----------------------------------------------------------------------------

# 最小利润阈值（0.001 = 0.1%）
# Min profit threshold (0.001 = 0.1%)
MIN_PROFIT_THRESHOLD=0.001

# 每腿最低可成交盘口深度（USD）：两侧卖单在限价内的累计金额都需 ≥ 此值，
# 用于过滤 5 分钟市场的护栏单/幻影挂单（检测到但提交时已消失的机会）。
# Min cumulative ask liquidity (USD) required on BOTH legs; filters guard orders.
MIN_ASK_DEPTH_USDC=10.0

# 连续单边成交熔断：连续 N 次单腿成交（另一腿 0 成交）触发安全闸暂停交易，
# 避免累积未对冲敞口。0 = 关闭。
# Trip the safety gate after N consecutive one-sided fills (0 = disabled).
ONE_SIDED_MAX_CONSECUTIVE=3

# 单腿最大名义金额（USDC / pUSD）；代码会按最终限价换算为 share 数量
# Max notional per leg; converted to shares using the final limit price
MAX_ORDER_SIZE_USDC=10.0

# 执行条件: yes + no <= 1 - spread（如 spread=0.01 时在 0.99 执行）
# Execute when yes + no <= 1 - spread (e.g. spread=0.01 triggers at 0.99)
ARBITRAGE_EXECUTION_SPREAD=0.03

# 动态手续费按市场参数精确计算后，仍需额外保留的模型/舍入安全边际
# Extra model/rounding safety margin required after dynamic market fees
ARBITRAGE_FEE_BUFFER=0.002

# YES / NO 价格下限，0 = 不限制
# Min YES/NO price; 0 = no filter
MIN_YES_PRICE_THRESHOLD=0.2
MIN_NO_PRICE_THRESHOLD=0.2

# 滑点 [first, second]: 下降侧用 second，上涨/持平用 first
# Slippage [first, second]: use second for declining side, first for rising/flat
SLIPPAGE=0.01,0.01

# 订单类型: GTC | GTD | FOK | FAK
# Order type: GTC | GTD | FOK | FAK
ARBITRAGE_ORDER_TYPE=GTD

# GTD 订单过期时间（秒），仅 ARBITRAGE_ORDER_TYPE=GTD 时生效
# GTD order expiry in seconds (only when ARBITRAGE_ORDER_TYPE=GTD)
GTD_EXPIRATION_SECS=300

# 演练模式：读取真实市场和账户数据，但不下单、撤单、Merge 或卖出
# Dry run: read live market/account data without orders, cancels, Merge or sells
DRY_RUN=false

# 极小额真实资金验证开关。默认关闭；实盘启用时订单类型必须为 FOK 或 FAK。
# Tiny real-money canary gate. Disabled by default; live canary requires FOK or FAK.
CANARY_MODE=false
# 单订单对、进程累计名义金额与保守损失预算。代码另有 10/20/5 USDC 绝对上限。
# Pair, process-total notional and conservative loss budgets; hard ceilings are 10/20/5 USDC.
CANARY_MAX_PAIR_NOTIONAL_USDC=3.0
CANARY_MAX_TOTAL_NOTIONAL_USDC=3.0
CANARY_MAX_LOSS_USDC=2.0
# 每窗口最多 1 对；单进程最多 3 对，默认仅允许 1 对。
# At most one pair per window and three per process; default is one total pair.
CANARY_MAX_PAIRS_PER_WINDOW=1
CANARY_MAX_PAIRS_TOTAL=1

# DRY_RUN 纸面撮合：虚拟初始现金、盘口可用深度折扣、两腿之间的模拟延迟
# DRY_RUN paper fills: virtual cash, usable-depth haircut, and inter-leg delay
PAPER_INITIAL_BALANCE_USDC=50.0
PAPER_LIQUIDITY_HAIRCUT=0.75
PAPER_SECOND_LEG_DELAY_MS=250
PAPER_WINNER_BUY_DELAY_MS=250

# 三个策略各自的可用额度。每个额度都在策略下单/虚拟现金预留前执行硬限制。
# Separate strategy budgets; each is enforced before order/paper-cash reservation.
ARBITRAGE_BUDGET_USDC=1000.0
WINNER_BUY_BUDGET_USDC=50.0
COPY_TRADING_BUDGET_USDC=10000.0

# 行情快照最大年龄、YES/NO 最大时间偏差，以及相同信号冷却时间（毫秒）
# Maximum snapshot age, YES/NO timestamp skew, and identical-signal cooldown (ms)
MAX_BOOK_AGE_MS=750
MAX_BOOK_SKEW_MS=200
SIGNAL_COOLDOWN_MS=3000
# 同一完整深度报价必须至少跨此时间出现两次才进入执行；0 = 关闭稳定确认
ARBITRAGE_SIGNAL_CONFIRMATION_MS=100
# 仅 DRY_RUN：候选首次出现后进行 REST 双腿只读采样的时点（毫秒）
ARBITRAGE_REST_SHADOW_DELAYS_MS=0,50,100,250
# 每个 REST 快照同时评估的单腿名义金额；至少保留能满足 5 shares 的较高档位
ARBITRAGE_REST_SHADOW_NOTIONALS_USDC=1,2,3,5


# -----------------------------------------------------------------------------
# [7] 风控 & 收尾
#     Risk & Wind-down  optional
# -----------------------------------------------------------------------------

# 旧版套利风险额度；未设置 ARBITRAGE_BUDGET_USDC 时作为兼容默认值
# Legacy arbitrage risk cap; fallback when ARBITRAGE_BUDGET_USDC is unset
RISK_MAX_EXPOSURE_USDC=1000.0

# 分策略结果文件；未设置时会根据 DRY_RUN 自动选择 results/.../paper|live/。
# Per-strategy results; defaults select results/.../paper|live/ from DRY_RUN.
# 旧版 STATE_JOURNAL_FILE 仍作为套利状态文件的兼容别名。
# Legacy STATE_JOURNAL_FILE remains an alias for the arbitrage state journal.
# ARBITRAGE_STATE_JOURNAL_FILE=results/spread-arbitrage/live/orders.ndjson
# WINNER_BUY_STATE_JOURNAL_FILE=results/winner-buy/live/orders.ndjson
# WINNER_BUY_EVALUATION_JOURNAL_FILE=results/winner-buy/live/evaluations.ndjson

# 仅允许进程启动以便核对/恢复；未解决状态仍禁止新实盘开仓
# Allows startup for reconciliation only; unresolved state still blocks live entries
ALLOW_UNRESOLVED_STATE=false

# 持仓不平衡阈值（0.1 = 10%）
# Position imbalance threshold (0.1 = 10%)
RISK_IMBALANCE_THRESHOLD=0.1

# 对冲止盈 / 止损比例
# Hedge take-profit / stop-loss ratio
HEDGE_TAKE_PROFIT_PCT=0.05
HEDGE_STOP_LOSS_PCT=0.05

# 市场结束前 N 分钟停止套利，0 = 不限制
# Stop arbitrage N minutes before market end; 0 = no limit
STOP_ARBITRAGE_BEFORE_END_MINUTES=2

# 窗口结束前收尾（取消挂单 → Merge → 市价卖剩余），0 = 关闭
# Wind-down before window end (cancel orders → Merge → market sell remainder); 0 = disabled
WIND_DOWN_BEFORE_WINDOW_END_MINUTES=1

# 收尾时单腿卖出限价
# Limit price for single-leg sell during wind-down
WIND_DOWN_SELL_PRICE=0.01

# 定时 Merge 间隔（分钟），0 = 关闭
# Scheduled Merge interval in minutes; 0 = disabled
MERGE_INTERVAL_MINUTES=1


# -----------------------------------------------------------------------------
# [8] 持仓同步
#     Position Sync  optional
# -----------------------------------------------------------------------------

# 持仓同步间隔（秒）
# Position sync interval in seconds
POSITION_SYNC_INTERVAL_SECS=10

# 仓位平衡检查间隔（秒）
# Position balance check interval in seconds
POSITION_BALANCE_INTERVAL_SECS=60

# 不平衡阈值
# Imbalance threshold to trigger balance action
POSITION_BALANCE_THRESHOLD=2.0

# 最小总持仓要求
# Min total position required to run balance check
POSITION_BALANCE_MIN_TOTAL=5.0


# -----------------------------------------------------------------------------
# [9] 日志 & 界面
#     Logging & UI  optional
# -----------------------------------------------------------------------------

# 日志级别: trace | debug | info | warn | error
# Log level: trace | debug | info | warn | error
RUST_LOG=info

# 日志文件路径
# Log file path
# LOG_FILE=logs/system.log

# 可选：分别记录两个策略的文本日志；启用后系统日志不再重复这些策略事件。
# Optional per-strategy logs; when set, matching events are not duplicated in the system log.
# ARBITRAGE_STRATEGY_LOG_FILE=logs/spread-arbitrage.log
# WINNER_BUY_STRATEGY_LOG_FILE=logs/winner-buy.log

# 可选：将达到初筛门槛的套利机会写为 NDJSON
# Optional: append pre-filtered opportunities as NDJSON
# ARBITRAGE_LOG_FILE=results/spread-arbitrage/live/opportunities.ndjson
# Optional dry-run research data for depth/admission rejects and REST counterfactual fills.
# ARBITRAGE_SHADOW_LOG_FILE=results/spread-arbitrage/paper/shadow-candidates.ndjson

# 启用终端 UI
# Enable terminal dashboard UI
# TUI_ENABLED=true

# 纯文本日志（关闭 TUI 着色）
# Plain-text logs (disable TUI styling)
# PLAIN_LOGS=false
# 运行期间按大小轮转日志（字节）并保留编号备份；适用于系统和分策略文本日志
# Rotate logs by size while running and retain numbered backups.
LOG_ROTATE_MAX_BYTES=10485760
LOG_ROTATE_FILES=5

# 可选本地可观测性端点：GET /livez、/readyz、/healthz 与 /metrics；留空则不监听端口
# Optional local observability endpoint: /livez, /readyz, /healthz and /metrics.
# 建议只绑定回环地址，外部暴露时应由反向代理增加认证和 TLS。
# Bind to loopback; add authentication/TLS at a reverse proxy before external exposure.
# OBSERVABILITY_BIND=127.0.0.1:9090

# === 策略 B：窗口末期买确定赢家（单腿方向性买入）===
# Window-end "buy the determined winner" strategy (single-leg directional buy).
# At window end the winner side's ask sits at 0.95-0.99 (deep guard-order
# liquidity); buying it and holding to settlement (pays 1.00) earns the edge.
# Initial strategy states; the TUI can pause/resume all three for the current process.
ARBITRAGE_ENABLED=true
WINNER_BUY_ENABLED=false
# 窗口剩余多少秒时触发（如 30 = 最后 30 秒）
WINNER_BUY_BEFORE_END_SECS=30
# 赢家侧卖一价 ≥ 此值才出手（方向视为已确定）；越低风险越大
WINNER_BUY_MIN_PRICE=0.95
WINNER_BUY_MAX_PRICE=0.98
# 0.98: edge 2%，盈亏平衡胜率 ~96%；0.97: edge 3%，盈亏平衡 ~94%（机会更少）
# 0.98: 2% edge, ~96% breakeven; 0.97: 3% edge, ~94% breakeven (fewer chances)
# 每笔最大金额（USDC）
WINNER_BUY_MAX_ORDER_USDC=50.0
# 每窗口最多买入次数（0 = 不限）
WINNER_BUY_MAX_PER_WINDOW=1
# 策略累计已实现亏损、单资产累计亏损、连续亏损熔断
WINNER_BUY_MAX_STRATEGY_LOSS_USDC=20.0
WINNER_BUY_MAX_ASSET_LOSS_USDC=10.0
WINNER_BUY_MAX_CONSECUTIVE_LOSSES=3
# 实盘胜出后自动提交链上赎回；dry-run 会始终模拟完整赎回生命周期
WINNER_BUY_AUTO_REDEEM=false
# 官方 Polymarket RTDS / Chainlink 60 秒 TWAP（策略独立概率源）
WINNER_BUY_RTDS_URL=wss://ws-live-data.polymarket.com
# Winner Buy 独立 WS 行情年龄；疑似候选或缺书时仍会通过 REST 严格确认
WINNER_BUY_MAX_BOOK_AGE_MS=1000
WINNER_BUY_FEED_MAX_AGE_MS=5000
WINNER_BUY_OPENING_MAX_SKEW_MS=5000
WINNER_BUY_VOLATILITY_LOOKBACK_SECS=120
WINNER_BUY_MIN_OBSERVATIONS=10
# 必须由不同的 Chainlink observation 连续确认，重复轮询同一条数据不计数
WINNER_BUY_CONFIRMATION_OBSERVATIONS=3
# 每市场有限重试；MAX_PER_WINDOW 现在统计真实执行尝试而不是扫描次数
WINNER_BUY_MAX_ATTEMPTS_PER_MARKET=1
WINNER_BUY_MIN_MARGIN_BPS=3.0
WINNER_BUY_REVERSAL_SIGMA=2.0
WINNER_BUY_MAX_SPREAD=0.03
WINNER_BUY_MIN_DEPTH_USDC=10.0
WINNER_BUY_MIN_NET_EV=0.002
# BTC、ETH 分开使用保守波动率下限和模型风险缓冲
WINNER_BUY_BTC_MIN_VOLATILITY_BPS=0.8
WINNER_BUY_ETH_MIN_VOLATILITY_BPS=1.2
WINNER_BUY_OTHER_MIN_VOLATILITY_BPS=1.5
WINNER_BUY_BTC_MODEL_RISK_BUFFER=0.01
WINNER_BUY_ETH_MODEL_RISK_BUFFER=0.015
WINNER_BUY_OTHER_MODEL_RISK_BUFFER=0.02

# -----------------------------------------------------------------------------
# [10] 多维度专家跟单策略
#      Multi-Factor Copy-Trading Strategy  optional
# -----------------------------------------------------------------------------

# 是否开启跟单策略；polypulse 内嵌运行当前仅允许 PAPER，独立 copy_trader 仍兼容原配置。
COPY_TRADING_ENABLED=true
# 模拟模式 (true 为不使用真金白银挂单的沙盒模拟模式；false 为真实 CLOB 限价下单)
COPY_DRY_RUN=true
# 实盘订单类型（当前仅允许 FAK/FOK；GTC/GTD 在完成持久化挂单对账前会拒绝启动）
COPY_ORDER_TYPE=FAK
# 实盘手续费缓冲（按名义金额比例预留，保证实际支出不超预算，默认 1%）
COPY_FEE_BUFFER_PCT=0.01
# API 新增字段由 SDK 兼容处理；仅诊断字段变化时开启逐字段 WARN
COPY_SHOW_SDK_SCHEMA_WARNINGS=false
# 防止 polypulse 内嵌服务和独立 copy_trader 同时写同一状态
COPY_RUNTIME_LOCK_FILE=data/copy-trading-runtime.lock

# 盯市/结算闭环
# 市价刷新时的订单簿合理性上限（相对价差 > 此值则保留上一有效 Mark，防稀薄盘口误触熔断；默认 5%）
COPY_MARK_MAX_SPREAD_PCT=0.05
# 市价刷新要求的最薄盘口深度（买一+卖一名义金额下限，默认 $5）
COPY_MARK_MIN_DEPTH_USDC=5.0
# 市场结算后赢家 Token 链上自动赎回（REDEEM_OUTPUT_TOKEN 默认 pUSD；需 POLYMARKET_PROXY_ADDRESS 与 Builder 凭据或 Safe 路径）
REDEEM_OUTPUT_TOKEN=pUSD

# 阶梯式离场（目标钱包清仓但本端一次未成时，按递减价分周期出清）
COPY_EXIT_LADDER_ENABLED=true
COPY_EXIT_LADDER_MAX_ATTEMPTS=3
COPY_EXIT_LADDER_STEP=0.005

# 白名单持久化（钱包画像与 3-strike 计数保存到 JSON 状态文件，重启热启动免重新拉取历史）
COPY_WHITELIST_STATE_FILE=data/copy-whitelist.json
COPY_WALLET_QUALITY_STATE_FILE=data/copy-wallet-quality.json
# 风险账本与信号幂等状态（仓位/NAV/熔断和已处理交易跨重启保留）
# COPY_RISK_STATE_FILE=data/copy-risk-paper.json
COPY_SIGNAL_STATE_FILE=data/copy-signals-seen.json
# 热启动时判定画像新鲜的天数上限（超过则重新评估）
COPY_WHITELIST_REFRESH_DAYS=7

# PAPER-only dynamic source audit/rotation. The scout report may be atomically refreshed while running.
COPY_AUTO_ROTATION_ENABLED=false
COPY_WALLET_QUALITY_AUDIT_MINUTES=360
COPY_ROTATION_CANDIDATE_REPORT=results/copy-candidates/rotation-current/report.json
COPY_ROTATION_MAX_REPORT_AGE_HOURS=24
COPY_ROTATION_MIN_BUY_SAMPLES=50
COPY_ROTATION_MIN_MARKET_SAMPLES=10
COPY_ROTATION_MIN_SHADOW_SAMPLES=10
COPY_ROTATION_MIN_FRESH_RATIO=0.25
COPY_ROTATION_MIN_ACTIONABLE_RATIO=0.05
COPY_ROTATION_MIN_MARKET_PASS_RATIO=0.15
COPY_ROTATION_MIN_SHADOW_EXECUTABLE_RATIO=0.15

# 链上事件信号源（绕过 data-api 3~15s 索引延迟，直接监听 CTF ERC-1155 转账）
COPY_ONCHAIN_FEED_ENABLED=false
# Polygon RPC（eth_getLogs 频繁查询建议用私有端点；已验证可用：https://polygon.drpc.org）
# 公共免费端点多有限流/超时（publicnode 会断连、1rpc 会 429）
COPY_ONCHAIN_RPC_URL=https://polygon.drpc.org
# 允许产生交易信号的 ERC-1155 operator 合约；留空时链上转账仅监控、不产生信号
COPY_ONCHAIN_ALLOWED_OPERATORS=

# 女巫共谋检测：声明同一主体的钱包对（逗号分隔 addr1:addr2），共识按独立主体计数
# 例：COPY_CORRELATED_WALLET_PAIRS=0xaaa...:0xbbb...,0xccc...:0xddd...
COPY_CORRELATED_WALLET_PAIRS=

# 运行日志与结果持久化（便于事后回归分析）
# 运行日志：stdout + 文件双写（LOG_FILE 默认 logs/copy-trader.log；轮转参数见 LOG_ROTATE_MAX_BYTES / LOG_ROTATE_FILES）
# LOG_FILE=logs/copy-trader.log
# 结构化结果：NDJSON 逐行 JSON 追加到 results/copy-trading/{paper|live}/events.ndjson（信号/共识/订单/结算/阶梯/NAV 快照/钱包画像）
# COPY_TRADING_RESULTS_DIR=results/copy-trading/paper
# Copy Trader 独立运行日志；优先级高于共享 LOG_FILE
# COPY_TRADING_LOG_FILE=logs/copy-trader.log
# 初始资金池净值 (USDC)
COPY_INITIAL_NAV_USDC=10000.0
# 监控目标钱包地址列表（逗号分隔的真实 Polymarket 钱包，历史从 data-api 实时拉取并画像）
# 留空则尝试从 builders leaderboard 自动发现（建议手动配置）
COPY_TARGET_WALLETS=
# Data API 钱包轮询间隔；扩大钱包池时建议 15 秒以上以降低 429
COPY_POLL_INTERVAL_SECONDS=15

# 1. 信号源画像漏斗规则
# 最少已结算事件数量 (>= 50)
COPY_MIN_SETTLED_EVENTS=50
# 活跃时间跨度天数 (>= 90)
COPY_MIN_ACTIVE_DAYS=90
# 加权开仓均价区间 (0.20 ~ 0.80)
COPY_MIN_AVG_ENTRY_PRICE=0.20
COPY_MAX_AVG_ENTRY_PRICE=0.80
# 单笔最大盈利占比上限 (<= 25%，排除幸存者偏差)
COPY_MAX_SINGLE_PROFIT_RATIO=0.25
# Maker 挂单成交比例上限 (< 90%，过滤高频做市商)
COPY_MAX_MAKER_RATIO=0.90

# 2. 标的池准入过滤
# 订单簿相对价差上限 (<= 2.0%)
COPY_MAX_SPREAD=0.02
# 24小时成交量下限 ($50,000)
COPY_MIN_24H_VOLUME_USDC=50000.0
# 距结算最少剩余小时数 (>= 72 小时，排除短线高频盘)
COPY_MIN_HOURS_TO_EXPIRY=72.0

# 3. 执行与价格保护 (反滑点/反接盘)
# 最大滑点百分比 (<= 1.5%)
COPY_MAX_SLIPPAGE_PCT=0.015
# 目标均价最大偏移绝对值 (<= +$0.015 美元)
COPY_MAX_PRICE_OFFSET_USD=0.015
# 限价单超时自动撤单秒数 TTL (30 ~ 60 秒)
COPY_DEFAULT_TTL_SECONDS=45
# Top-5 深度流动性占用上限 (<= 10%，防出货熔断)
COPY_MAX_TOP5_DEPTH_PCT=0.10

# 4. 仓位管理与风控熔断
# 单笔交易分配资金池比例 (1% ~ 3%，默认 2%)
COPY_SINGLE_TRADE_ALLOCATION_PCT=0.02
# 单一事件最大敞口上限 (<= 10%)
COPY_MAX_SINGLE_MARKET_EXPOSURE_PCT=0.10
# 组合总敞口上限（全部市场合计，默认 30%）
COPY_MAX_TOTAL_EXPOSURE_PCT=0.30
# 单日最大净亏损回撤熔断线 (5%，触达后暂停 24 小时)
COPY_DAILY_MAX_DRAWDOWN_PCT=0.05
# 熔断冷却时长（小时）
COPY_CIRCUIT_BREAKER_COOLDOWN_HOURS=24
# 最小订单名义金额 (USDC)
COPY_MIN_ORDER_NOTIONAL_USDC=5.0

# 5. 多源共识与平仓闭环
# 多源共识聚合时间窗口 (12 小时)
COPY_CONSENSUS_WINDOW_HOURS=12
# 单条信号最大年龄，防启动/重启时重放 Data API 历史成交
COPY_MAX_SIGNAL_AGE_SECONDS=120
# 仅 PAPER：允许更老的延迟信号进入 shadow 观测，但不得进入模拟资金账本
COPY_SHADOW_MAX_SIGNAL_AGE_SECONDS=300
# 触发共识所需同赛道独立专家钱包数 (>= 2 个)
COPY_MIN_CONSENSUS_WALLETS=2
# 计入共识的信号最小名义金额（过滤灰尘单，默认 $100）
COPY_MIN_SIGNAL_NOTIONAL_USDC=100.0
# 仅 PAPER：小额信号执行只读盘口 shadow 的最低金额，不进入共识/资金账本
COPY_SHADOW_MIN_SIGNAL_NOTIONAL_USDC=10.0
# PAPER 建议单生成后等待并重新抓取未缓存盘口，再模拟成交
COPY_PAPER_EXECUTION_DELAY_MS=500
# 共识 VWAP 合理性下限/上限（防异常信号拉高价格上限）
COPY_MIN_SIGNAL_VWAP=0.05
COPY_MAX_SIGNAL_VWAP=0.95
# 目标钱包减仓触发平仓比例 (>= 30%)
COPY_EXIT_TRIGGER_REDUCTION_PCT=0.30
# 准入最大可接受 Brier 分数
COPY_MAX_ACCEPTABLE_BRIER_SCORE=0.25
# 连续重大方向误判 3 连击拉黑
COPY_MAX_CONSECUTIVE_DIRECTION_ERRORS=3

# =============================================================================
# Maker Liquidity feasibility research (read-only; never submits orders)
# =============================================================================
MAKER_RESULTS_FILE=results/maker-liquidity/shadow-run-003/events.ndjson
MAKER_MAX_MARKETS=5
MAKER_DISCOVERY_PAGES=3
MAKER_ENRICHMENT_LIMIT=100
MAKER_REQUEST_CONCURRENCY=8
MAKER_MIN_DAILY_REWARD_USDC=3.0
MAKER_MAX_REWARDS_MIN_SIZE=100.0
MAKER_MIN_LIQUIDITY_USDC=300.0
MAKER_MIN_VOLUME_24H_USDC=1000.0
MAKER_MAX_FEE_RATE=0.05
MAKER_HIGH_FEE_THRESHOLD=0.04
MAKER_HIGH_FEE_VOLUME_MULTIPLIER=2.0
MAKER_MAX_OBSERVED_SPREAD=0.06
MAKER_MIN_MIDPOINT=0.10
MAKER_MAX_MIDPOINT=0.90
# Empty means all categories; examples: crypto, weather, politics, or text keyword
MAKER_MARKET_FILTER=
MAKER_QUOTE_SIZE_SHARES=20.0
MAKER_QUOTE_HALF_SPREAD=0.01
MAKER_QUOTE_HALF_SPREAD_GRID=0.01,0.02,0.03
MAKER_DYNAMIC_QUOTE_DISTANCE=true
MAKER_REWARD_BAND_FRACTION=0.80
MAKER_MAX_MIDPOINT_MOVE=0.02
MAKER_MIDPOINT_MOVE_WINDOW_SECS=30
MAKER_MIN_TRADES_1H=3
MAKER_BOOK_ACTIVITY_WINDOW_SECS=300
MAKER_MIN_BOOK_UPDATES=3
MAKER_MAX_INVENTORY_SHARES=40
MAKER_INVENTORY_SKEW_PER_SHARE=0.00025
MAKER_MAX_CONSECUTIVE_NEGATIVE_MARKOUTS=3
MAKER_MAX_QUOTES_PER_MARKET_HOUR=120
MAKER_BOOK_POLL_SECS=5
MAKER_QUOTE_INTERVAL_SECS=30
MAKER_MARKET_REFRESH_SECS=300
MAKER_MARKET_COOLDOWN_SECS=1800
MAKER_MAX_CONSECUTIVE_MARKET_ERRORS=6
MAKER_MIN_TIME_TO_END_SECS=7200
MAKER_HTTP_MAX_RETRIES=3
MAKER_RETRY_BASE_MS=250
MAKER_TRADE_CACHE_SECS=5
MAKER_WEBSOCKET_BOOKS=true
MAKER_WEBSOCKET_BOOK_MAX_AGE_MS=15000
MAKER_MARKOUT_HORIZONS_SECS=1,5,30,60
# 0 runs until Ctrl-C
MAKER_SHADOW_DURATION_SECS=0

# =============================================================================
# Bayesian Coherence cross-market research (read-only; never submits orders)
# =============================================================================
BAYESIAN_RESULTS_FILE=results/bayesian-arbitrage/shadow-run-002/events.ndjson
BAYESIAN_EVENT_PAGES=10
BAYESIAN_EVENTS_PER_PAGE=100
BAYESIAN_MAX_RELATIONSHIPS=500
# Complete NegRisk sets above this number are skipped to bound requests/leg risk
BAYESIAN_MAX_PARTITION_LEGS=12
BAYESIAN_REQUEST_CONCURRENCY=12
BAYESIAN_POLL_SECONDS=10
# Unchanged evaluations are emitted only at this heartbeat interval
BAYESIAN_UNCHANGED_LOG_SECONDS=600
BAYESIAN_RELATIONSHIP_REFRESH_SECONDS=300
BAYESIAN_SUMMARY_SECONDS=600
BAYESIAN_RESULTS_MAX_BYTES=52428800
BAYESIAN_RESULTS_RETENTION_FILES=5
BAYESIAN_SIZE_LADDER_SHARES=1,2,5,10,20,50,100
BAYESIAN_MIN_BUNDLE_NOTIONAL_USDC=1.0
# Net of per-market taker fees and execution buffer
BAYESIAN_MIN_NET_EDGE=0.01
BAYESIAN_EXECUTION_BUFFER_PCT=0.003
# Comma-separated relationship IDs; labels reviewed research only, never enables live execution
BAYESIAN_SEMANTIC_ALLOWLIST=
# 0 runs until Ctrl-C
BAYESIAN_SHADOW_DURATION_SECONDS=0
# 是否隔离多结果/NegRisk 复杂市场
COPY_ISOLATE_MULTI_OUTCOME=true
